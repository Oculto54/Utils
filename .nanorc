# Nano configuration

# Syntax highlighting is enabled by update.sh with a local include block.
# The include path depends on where nano is installed on the target system.

# Show line numbers
set linenumbers

# Auto-indent new lines
set autoindent

# Disable mouse to avoid interference with terminal selection
# set mouse

# Set tab width to 4 spaces
set tabsize 4

# Convert tabs to spaces
set tabstospaces

# Disable hard wrapping to keep lines intact for copying
unset breaklonglines

# Case-insensitive search
unset casesensitive
