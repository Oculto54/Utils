# Enable syntax highlighting for all available languages


#   
# Show line numbers
set linenumbers

# Auto-indent new lines
set autoindent

# Disable mouse to avoid interference with terminal selection
# set mouse

# Set tab width to 4 spaces
set tabsize 4

# Convert tabs to spaces
set tabstospaces

# Disable soft wrap to keep lines intact for copying
set nowrap

# Case-insensitive search 
set casesensitive off   